				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="NecrosisMessageMenu" relativeFrom="TOPLEFT">
						<Offset>
							<AbsDimension x="30" y="-35"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						if (this:GetChecked()) then
							NecrosisConfig.AntiFearAlert = true;
						else
							NecrosisConfig.AntiFearAlert = false;
						end
